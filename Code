<div style="position:relative;width:100%;max-width:260px;border-radius:8px;overflow:hidden;margin:0 auto;">


<script>
function openDirections() {
  const venueLat = 18.565917;
  const venueLng = 73.907444; // Symbiosis College Auditorium

  if (!navigator.geolocation) {
    window.open(
      `https://www.google.com/maps/dir/?api=1&destination=${venueLat},${venueLng}`,
      "_blank"
    );
    return;
  }

  navigator.geolocation.getCurrentPosition(
    position => {
      const userLat = position.coords.latitude;
      const userLng = position.coords.longitude;

      const directionsUrl =
        `https://www.google.com/maps/dir/?api=1` +
        `&origin=${userLat},${userLng}` +
        `&destination=${venueLat},${venueLng}` +
        `&travelmode=driving`;

      window.open(directionsUrl, "_blank");
    },
    () => {
      window.open(
        `https://www.google.com/maps/dir/?api=1&destination=${venueLat},${venueLng}`,
        "_blank"
      );
    },
    {
      enableHighAccuracy: true,
      timeout: 8000,
      maximumAge: 0
    }
  );
}
</script>
